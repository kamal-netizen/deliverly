# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role bypasses RLS. Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Shopify ---
SHOPIFY_API_KEY=your-api-key
SHOPIFY_API_SECRET=your-api-secret
# Leave blank unless you declared app-level webhook subscriptions in the
# Partner dashboard. Webhooks registered through the Admin API - which is what
# this app does at install time - are signed with SHOPIFY_API_SECRET.
SHOPIFY_WEBHOOK_SECRET=
# read_customers is required: the order webhook reads payload.customer for the
# customer name and phone. Without it every order imports as "Unknown".
SHOPIFY_SCOPES=read_orders,write_orders,write_fulfillments,read_customers
# Admin API version. Shopify supports each version for 12 months from release.
SHOPIFY_API_VERSION=2026-01

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public base URL Shopify webhooks are registered against. In local development
# this is your tunnel (cloudflared / ngrok), not localhost. Defaults to
# NEXT_PUBLIC_APP_URL when unset.
WEBHOOK_URL=
# Where the Shopify OAuth callback sends the merchant. Defaults to NEXT_PUBLIC_APP_URL.
FRONTEND_DASHBOARD_URL=
# IANA timezone used to bucket "today" on the dashboard. Without this, counts
# are bucketed against the server clock, which is UTC on most hosts.
MERCHANT_TIMEZONE=Asia/Dubai
# How far back the first sync reaches, in days. An established store can hold
# tens of thousands of orders; a delivery app only needs the recent ones.
# POST /api/sync/orders?full=true is the deliberate full backfill.
SYNC_INITIAL_DAYS=30

# --- Rider app ---
# Where the rider APK is hosted. The dashboard's riders page shows a download
# and a copy-link button when this is set, and says it is unconfigured when it
# is not - it never renders a dead link. The APK is not committed to this
# repository: at ~25MB it would be paid for on every clone and every deploy.
# A GitHub release on the rider repository is the simplest host, and its
# "latest" URL is stable, so this needs no update when a new build ships:
#   https://github.com/<owner>/deliverly-rider/releases/latest/download/<file>.apk
NEXT_PUBLIC_RIDER_APP_URL=
