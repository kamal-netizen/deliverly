# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role bypasses RLS. Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Shopify ---
SHOPIFY_API_KEY=your-api-key
SHOPIFY_API_SECRET=your-api-secret
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret
# read_customers is required: the order webhook reads payload.customer for the
# customer name and phone. Without it every order imports as "Unknown".
SHOPIFY_SCOPES=read_orders,write_orders,write_fulfillments,read_customers
# Admin API version. Shopify supports each version for 12 months from release.
SHOPIFY_API_VERSION=2025-07

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public base URL Shopify webhooks are registered against. In local development
# this is your tunnel (cloudflared / ngrok), not localhost. Defaults to
# NEXT_PUBLIC_APP_URL when unset.
WEBHOOK_URL=
# Where the Shopify OAuth callback sends the merchant. Defaults to NEXT_PUBLIC_APP_URL.
FRONTEND_DASHBOARD_URL=
# IANA timezone used to bucket "today" on the dashboard. Without this, counts
# are bucketed against the server clock, which is UTC on most hosts.
MERCHANT_TIMEZONE=Asia/Dubai
